# .env.example — Vorlage für App-Secrets (committed, KEINE echten Werte).
# Kopiere diese Datei nach .env und trage die echten Werte ein:
#   cp .env.example .env
# Dann verschlüsseln:
#   bash scripts/encrypt-env.sh
# .env ist gitignored (nie committen); .env.gpg wird committiert.

# Beispiel-Variablen — durch projektspezifische Namen ersetzen:
# APP_SECRET=changeme
# DATABASE_URL=postgres://user:password@localhost:5432/mydb
# API_KEY=changeme

# Socket-Adapter (S-005, docs/specs/dateneingang.md AC3):
# FRED_API_KEY=changeme

# LLM-Grounding Cross-Check-Toleranzen (S-013, docs/specs/llm-grounding.md AC5):
# JSON-Mapping Kennzahl-Typ -> {"typ": "absolut"|"relativ", "schwelle": <Zahl>}.
# ERSETZT bei Angabe das VOLLSTAENDIGE Default-Mapping aus app/config.py
# (DEFAULT_TOLERANZEN) - kein Merge mit den Defaults. Kein Secret-Wert.
# TOLERANZ_CONFIG={"kgv": {"kennzahl_typ": "kgv", "typ": "relativ", "schwelle": 0.02}}

# Halluzinations-KPI-Schwellwert (S-027, docs/specs/llm-grounding.md AC9):
# Ab STRIKTER Ueberschreitung dieser Quote (0.02 = 2 %) nimmt
# app.core.hallucination_kpi das LLM aus der Entscheidungskette (BR-006).
# Kein Secret-Wert.
# HALLUZINATIONS_KPI_SCHWELLWERT=0.02

# Drawdown-Alert-/Kill-Schwellen (S-025, docs/specs/betriebssicherung.md
# AC2, AC5): unabhaengig konfigurierbare Schwellen fuer den relativen
# Portfolio-Rueckgang vom laufenden Hoechststand (0.10 = 10 %). Bei
# Ueberschreiten der Kill-Schwelle wird app.core.kill_switch.ausloesen()
# automatisch mit Quelle "drawdown" aufgerufen. Provisorische Defaults
# (10 % Alert / 20 % Kill) in app/config.py. Kein Secret-Wert.
# DRAWDOWN_ALERT_SCHWELLE=0.10
# DRAWDOWN_KILL_SCHWELLE=0.20

# Scheduler-Backoff/Token-Bucket (S-020, docs/specs/dateneingang.md
# AC10/AC11): provisorische, ohne Codeaenderung ueberschreibbare Defaults
# fuer app.scheduler.* (Exponential Backoff vor Dead-Letter-Queue, AC10;
# Token-Bucket-Kapazitaet/Nachfuellrate je Quelle, AC11). Kein Secret-Wert.
# SCHEDULER_BACKOFF_BASIS_SEKUNDEN=1.0
# SCHEDULER_MAX_VERSUCHE=5
# SCHEDULER_TOKEN_BUCKET_CAPACITY=5
# SCHEDULER_TOKEN_BUCKET_REFILL_PRO_SEKUNDE=1.0
# Geschaetzte Slippage fuer die Pre-Trade-Kostenkalkulation (S-017,
# docs/specs/ausfuehrung-paper.md AC11): Prozent-Zahl des Order-Werts (z.B.
# 0.05 = 0.05 % / 5 Basispunkte, analog courtage_pct/typ_spread_pct in
# docs/data-model.md - NICHT als Anteil 0-1 zu lesen), die
# app.db.trading_platform.berechne_erwartete_kosten() zusaetzlich zu
# Courtage/Spread einrechnet. Kein tatsaechliches Fill-Modell (das ist
# AC9/S-049). Kein Secret-Wert.
# ERWARTETE_SLIPPAGE_PCT_DEFAULT=0.05

# Secret-Store mit strikter Paper/Live-Trennung (S-008,
# docs/specs/betriebssicherung.md AC6): app.core.secrets.resolve_secret_store_zugang
# loest Zugangsdaten ausschliesslich ueber Env-Variablen im Schema
# <DIENST>_<UMGEBUNG>_ENDPOINT / _API_KEY / _API_SECRET auf (UMGEBUNG = PAPER
# oder LIVE, jeweils EIGENER Namensraum - kein gemeinsamer Basisname, kein
# Fallback zwischen den Umgebungen). Noch kein konkreter Dienst (Broker o.ae.)
# konsumiert dies; Beispiel fuer einen kuenftigen Broker "ibkr":
# IBKR_PAPER_ENDPOINT=changeme
# IBKR_PAPER_API_KEY=changeme
# IBKR_LIVE_ENDPOINT=changeme
# IBKR_LIVE_API_KEY=changeme
# Einstand-Methode-Default (S-016, docs/specs/depot.md AC5, BR-112):
# gleitender_durchschnitt (CH-Default) oder fifo. Gilt nur fuer den
# allerersten Kauf eines Titels - bestehende offene Lots tragen ihre
# Methode bereits selbst. Kein Secret-Wert.
# EINSTAND_METHODE_DEFAULT=gleitender_durchschnitt

# Kandidatensuche Querschnitt-Filter + Suchprofil-Overrides (S-029,
# docs/specs/kandidatensuche.md AC6/AC7/AC10): provisorische, unkalibrierte
# Defaults (Liquiditaet >= 1 meldende Quelle, Volatilitaets-Fenster
# [0, 1000000]) - siehe app/config.py Modul-Docstring. Kein Secret-Wert.
# KANDIDATENSUCHE_LIQUIDITAETS_MINDESTSCHWELLE=1
# KANDIDATENSUCHE_VOLATILITAETS_FENSTER_MIN=0
# KANDIDATENSUCHE_VOLATILITAETS_FENSTER_MAX=1000000
# JSON-Mapping Anlageklasse (String-Key) -> {"modus": "eventbasiert"|
# "periodisch", "schwellen": {...}} - GEMERGED in das registrierte
# Suchprofil (nur genannte Keys/Felder werden ersetzt).
# KANDIDATENSUCHE_PROFIL_OVERRIDES={"1": {"modus": "periodisch"}}
