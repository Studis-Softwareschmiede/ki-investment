# .env.example — Vorlage für App-Secrets (committed, KEINE echten Werte).
# Kopiere diese Datei nach .env und trage die echten Werte ein:
#   cp .env.example .env
# Dann verschlüsseln:
#   bash scripts/encrypt-env.sh
# .env ist gitignored (nie committen); .env.gpg wird committiert.

# Beispiel-Variablen — durch projektspezifische Namen ersetzen:
# APP_SECRET=changeme
# DATABASE_URL=postgres://user:password@localhost:5432/mydb
# API_KEY=changeme

# Socket-Adapter (S-005, docs/specs/dateneingang.md AC3):
# FRED_API_KEY=changeme

# LLM-Grounding Cross-Check-Toleranzen (S-013, docs/specs/llm-grounding.md AC5):
# JSON-Mapping Kennzahl-Typ -> {"typ": "absolut"|"relativ", "schwelle": <Zahl>}.
# ERSETZT bei Angabe das VOLLSTAENDIGE Default-Mapping aus app/config.py
# (DEFAULT_TOLERANZEN) - kein Merge mit den Defaults. Kein Secret-Wert.
# TOLERANZ_CONFIG={"kgv": {"kennzahl_typ": "kgv", "typ": "relativ", "schwelle": 0.02}}
