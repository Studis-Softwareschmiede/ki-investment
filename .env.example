# .env.example — Vorlage für App-Secrets (committed, KEINE echten Werte).
# Kopiere diese Datei nach .env und trage die echten Werte ein:
#   cp .env.example .env
# Dann verschlüsseln:
#   bash scripts/encrypt-env.sh
# .env ist gitignored (nie committen); .env.gpg wird committiert.

# Beispiel-Variablen — durch projektspezifische Namen ersetzen:
# APP_SECRET=changeme
# DATABASE_URL=postgres://user:password@localhost:5432/mydb
# API_KEY=changeme

# Socket-Adapter (S-005, docs/specs/dateneingang.md AC3):
# FRED_API_KEY=changeme

# LLM-Grounding Cross-Check-Toleranzen (S-013, docs/specs/llm-grounding.md AC5):
# JSON-Mapping Kennzahl-Typ -> {"typ": "absolut"|"relativ", "schwelle": <Zahl>}.
# ERSETZT bei Angabe das VOLLSTAENDIGE Default-Mapping aus app/config.py
# (DEFAULT_TOLERANZEN) - kein Merge mit den Defaults. Kein Secret-Wert.
# TOLERANZ_CONFIG={"kgv": {"kennzahl_typ": "kgv", "typ": "relativ", "schwelle": 0.02}}

# Halluzinations-KPI-Schwellwert (S-027, docs/specs/llm-grounding.md AC9):
# Ab STRIKTER Ueberschreitung dieser Quote (0.02 = 2 %) nimmt
# app.core.hallucination_kpi das LLM aus der Entscheidungskette (BR-006).
# Kein Secret-Wert.
# HALLUZINATIONS_KPI_SCHWELLWERT=0.02

# Secret-Store mit strikter Paper/Live-Trennung (S-008,
# docs/specs/betriebssicherung.md AC6): app.core.secrets.resolve_secret_store_zugang
# loest Zugangsdaten ausschliesslich ueber Env-Variablen im Schema
# <DIENST>_<UMGEBUNG>_ENDPOINT / _API_KEY / _API_SECRET auf (UMGEBUNG = PAPER
# oder LIVE, jeweils EIGENER Namensraum - kein gemeinsamer Basisname, kein
# Fallback zwischen den Umgebungen). Noch kein konkreter Dienst (Broker o.ae.)
# konsumiert dies; Beispiel fuer einen kuenftigen Broker "ibkr":
# IBKR_PAPER_ENDPOINT=changeme
# IBKR_PAPER_API_KEY=changeme
# IBKR_LIVE_ENDPOINT=changeme
# IBKR_LIVE_API_KEY=changeme
